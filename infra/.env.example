# Optional: copy to infra/.env to override the defaults in docker-compose.yml.

# Object storage (MinIO-compatible). lakekeeper/create-warehouse.json uses the same credentials,
# so change both together.
# MINIO_ROOT_USER=minio-root-user
# MINIO_ROOT_PASSWORD=minio-root-password

# Lakekeeper
# LAKEKEEPER_VERSION=v0.13.6
# LAKEKEEPER_ENCRYPTION_KEY=This-is-NOT-Secure!

# Trino
# TRINO_VERSION=483

# OpenLineage -> Marquez (not wired up yet)
# OPENLINEAGE_URL=http://localhost:5000
# LINEAGE_JOB_NAMESPACE=iceberg-elt-demo
# LINEAGE_DATASET_NS=iceberg://lakekeeper/demo
